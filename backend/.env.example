PORT=3001

# Postgres from docker-compose.yml (`npm run db:up` at the root)
DATABASE_URL="postgresql://shigjetademy:shigjetademy@localhost:5432/shigjetademy"

# Platform admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@shigjetademy.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Sign access (15m) and refresh (7d) tokens. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Outgoing email (invitations). Defaults send to Mailpit from docker-compose: open http://localhost:8025.
# Real email: point these at an SMTP provider, e.g. Brevo (smtp-relay.brevo.com, 587) with its SMTP login and key.
# In production SMTP_HOST and APP_URL are required.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="invitations@shigjetademy.local"

# Base URL used in links inside emails
APP_URL="http://localhost:5173"
