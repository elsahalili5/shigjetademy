generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OrganizationType {
  SCHOOL
  KINDERGARTEN
  ACADEMY
  TRAINING_CENTRE
  INDEPENDENT_LECTURER
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// A user's role inside one organization
enum MemberRole {
  OWNER
  ADMIN
  LECTURER
  STUDENT
  GUARDIAN
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

/// What a School Admin may do; the owner always has all of them
enum Permission {
  MANAGE_STUDENTS
  MANAGE_LECTURERS
  MANAGE_GUARDIANS
  MANAGE_COURSES
  MANAGE_SCHEDULES
  MANAGE_ATTENDANCE
  MANAGE_GRADES
  MANAGE_MATERIALS
  MANAGE_TESTS
  VIEW_PERFORMANCE
  VIEW_REPORTS
  MANAGE_ACADEMIC_PERIODS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ActivityAction {
  ORGANIZATION_SUSPENDED
  ORGANIZATION_REACTIVATED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  MEMBER_UPDATED
  MEMBER_REMOVED
  ORGANIZATION_PROFILE_UPDATED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_REMOVED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_REMOVED
  ACADEMIC_YEAR_CREATED
  ACADEMIC_YEAR_UPDATED
  ACADEMIC_YEAR_REMOVED
  ACADEMIC_TERM_CREATED
  ACADEMIC_TERM_UPDATED
  ACADEMIC_TERM_REMOVED
  ACADEMIC_HOLIDAY_CREATED
  ACADEMIC_HOLIDAY_UPDATED
  ACADEMIC_HOLIDAY_REMOVED
  ORGANIZATION_SETTINGS_UPDATED
  OWNERSHIP_TRANSFERRED
  ORGANIZATION_DEACTIVATED_BY_OWNER
  ORGANIZATION_REACTIVATED_BY_OWNER
  STUDENT_ADDED
  STUDENT_UPDATED
  STUDENT_ARCHIVED
  STUDENT_RESTORED
  LECTURER_ADDED
  LECTURER_UPDATED
  LECTURER_ARCHIVED
  LECTURER_RESTORED
  COURSE_ADDED
  COURSE_UPDATED
  COURSE_ARCHIVED
  COURSE_RESTORED
  GROUP_ADDED
  GROUP_UPDATED
  GROUP_ARCHIVED
  GROUP_RESTORED
  GROUP_SUBSTITUTION_ADDED
  GROUP_SUBSTITUTION_UPDATED
  GROUP_SUBSTITUTION_CANCELLED
  GROUP_STUDENT_ENROLLED
  GROUP_STUDENT_WITHDRAWN
  GROUP_STUDENT_MOVED
  ATTENDANCE_CORRECTED
  LESSON_RESCHEDULED
  LESSON_RESCHEDULE_CANCELLED
  INVITATION_SENT
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  PLATFORM_SETTINGS_UPDATED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum LecturerStatus {
  ACTIVE
  ARCHIVED
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

/// How a student was marked on a lesson day; a student nobody has marked has no row
enum AttendanceStatus {
  PRESENT
  TARDY
  ABSENT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum WeekStart {
  MONDAY
  SUNDAY
}

enum DateFormat {
  DAY_MONTH_YEAR
  MONTH_DAY_YEAR
}

// ─────────────────────────────────────────
// USERS & PLATFORM ROLES
// ─────────────────────────────────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  first_name          String
  last_name           String
  email               String     @unique
  password_hash       String
  status              UserStatus @default(PENDING)

  lockout_enabled     Boolean    @default(true)
  access_failed_count Int        @default(0)
  locked_until        DateTime?
  email_confirmed     Boolean    @default(false)

  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  user_roles          UserRole[]
  user_tokens         UserTokens[]
  refresh_tokens      RefreshTokens[]
  memberships         Membership[]
  sent_invitations    Invitation[] @relation("InvitedBy")
  activity_as_actor   ActivityLog[] @relation("ActivityActor")
  activity_as_target  ActivityLog[] @relation("ActivityTarget")
  attendance_marked   AttendanceRecord[]
  lesson_reschedules  LessonReschedule[]
  lesson_plans_written LessonPlan[]
  student_records     Student[]
  lecturer_records    Lecturer[]
}

/// Platform-wide roles (PLATFORM_ADMIN); organization roles live on Membership
model Role {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  normalized_name String     @unique
  description     String?
  user_roles      UserRole[]
}

model UserRole {
  user_id String @db.Uuid
  role_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
}

// ─────────────────────────────────────────
// TOKEN MANAGEMENT
// ─────────────────────────────────────────

model RefreshTokens {
  id      String   @id @default(uuid()) @db.Uuid
  user_id String   @db.Uuid
  token   String   @unique
  expires DateTime
  created DateTime @default(now())
  revoked Boolean  @default(false)

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// One-time tokens for password reset and email verification, stored hashed
model UserTokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       TokenType
  token_hash String    @unique
  expires    DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
}

// ─────────────────────────────────────────
// ORGANIZATIONS & MEMBERSHIP
// ─────────────────────────────────────────

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  type         OrganizationType
  country      String             @db.Char(2)
  currency     String             @db.Char(3)
  size         String?
  email        String?
  phone        String?
  website      String?
  /// Shigjetademy's share of each student payment, in hundredths of a percent (300 = 3%)
  fee_rate_bps Int                @default(300)
  status       OrganizationStatus @default(ACTIVE)
  /// Set once, from the platform's default trial days, when the organization is created; never changed afterward by a platform settings change
  trial_ends_at DateTime?

  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  activity     ActivityLog[]
  locations      Location[]
  departments    Department[]
  academic_years AcademicYear[]
  settings       OrganizationSettings?
  students       Student[]
  lecturers      Lecturer[]
  courses        Course[]
  groups         Group[]
}

/// How one organization runs. An organization without a row reads the defaults; the row is written on its first save.
model OrganizationSettings {
  organization_id String       @id @db.Uuid
  /// An IANA time zone, like Europe/Belgrade
  time_zone       String
  week_start      WeekStart    @default(MONDAY)
  date_format     DateFormat   @default(DAY_MONTH_YEAR)

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

/// How the whole platform runs: one row, written on its first save. Reading it when it doesn't exist yet returns the defaults.
model PlatformSettings {
  id                  Int      @id @default(1)
  platform_name       String   @default("Shigjetademy")
  logo_url            String?
  maintenance_mode    Boolean  @default(false)
  maintenance_message String?
  /// How many days a new organization's trial runs; 0 means no trial
  default_trial_days  Int      @default(14)

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

/// A campus or branch. While an organization has any, exactly one is its main location (kept by the location service).
model Location {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  address         String?
  city            String?
  phone           String?
  is_main         Boolean      @default(false)

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  departments     Department[]
  lecturers       LecturerLocation[]
  groups          Group[]

  @@index([organization_id])
}

/// Removing its location keeps the department, without a location
model Department {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  location_id     String?      @db.Uuid
  name            String
  description     String?

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  location        Location?    @relation(fields: [location_id], references: [id], onDelete: SetNull)
  lecturers       Lecturer[]
  courses         Course[]

  @@unique([organization_id, name])
  @@index([location_id])
}

// ─────────────────────────────────────────
// ACADEMIC PERIODS
// ─────────────────────────────────────────

/// A school year. Years in one organization don't overlap, and while it has any, exactly one is current (kept by the academic periods service).
model AcademicYear {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  /// Calendar days, so time zones never shift them
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  is_current      Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  terms        AcademicTerm[]
  holidays     AcademicHoliday[]
  groups       Group[]

  @@index([organization_id])
}

/// A term inside its year; terms of one year don't overlap
model AcademicTerm {
  id               String   @id @default(uuid()) @db.Uuid
  academic_year_id String   @db.Uuid
  name             String
  start_date       DateTime @db.Date
  end_date         DateTime @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  groups        Group[]

  @@index([academic_year_id])
}

/// A holiday or break inside its year, one day or several; it may overlap terms
model AcademicHoliday {
  id               String   @id @default(uuid()) @db.Uuid
  academic_year_id String   @db.Uuid
  name             String
  start_date       DateTime @db.Date
  end_date         DateTime @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)

  @@index([academic_year_id])
}

// ─────────────────────────────────────────
// STUDENTS
// ─────────────────────────────────────────

/// A student the organization keeps a record of. It is not an account: academic data hangs on the student's id, never on a user's,
/// so linking a login later never creates a second record or changes history.
model Student {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  first_name      String
  last_name       String
  date_of_birth   DateTime?     @db.Date
  /// Unique in the organization; assigned as STU-0001, STU-0002… unless staff type their own
  student_number  String
  enrolled_on     DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  status          StudentStatus @default(ACTIVE)
  /// The login linked to this record, at most one; none until student logins exist
  user_id         String?       @db.Uuid
  notes           String?

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  invitations     Invitation[]
  group_enrolments GroupEnrolment[]
  attendance       AttendanceRecord[]

  @@unique([organization_id, student_number])
  @@unique([organization_id, user_id])
  @@index([organization_id, status])
  @@index([organization_id, last_name])
}

// ─────────────────────────────────────────
// LECTURERS
// ─────────────────────────────────────────

/// A lecturer the organization keeps a record of, like a student: login optional, linked later by an invitation,
/// so a school can list a teacher before they have an account.
model Lecturer {
  id              String         @id @default(uuid()) @db.Uuid
  organization_id String         @db.Uuid
  first_name      String
  last_name       String
  email           String?
  phone           String?
  /// Free-text tags like "Mathematics", kept in the first casing the organization used
  subjects        String[]
  employment_type EmploymentType
  started_on      DateTime?      @db.Date
  notes           String?
  /// At most one; removing the department keeps the lecturer, without one
  department_id   String?        @db.Uuid
  status          LecturerStatus @default(ACTIVE)
  /// The login linked to this record, at most one
  user_id         String?        @db.Uuid

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  department      Department?        @relation(fields: [department_id], references: [id], onDelete: SetNull)
  user            User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  locations       LecturerLocation[]
  invitations     Invitation[]
  group_assignments GroupLecturerAssignment[]
  group_substitutions GroupSubstitution[]

  @@unique([organization_id, user_id])
  @@index([organization_id, status])
  @@index([organization_id, last_name])
  @@index([department_id])
}

/// Where a lecturer teaches; removing either side removes only the link
model LecturerLocation {
  lecturer_id String   @db.Uuid
  location_id String   @db.Uuid

  lecturer    Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@id([lecturer_id, location_id])
  @@index([location_id])
}

// ─────────────────────────────────────────
// COURSES
// ─────────────────────────────────────────

/// Something the organization teaches. Courses are archived, never deleted; names and codes stay taken while archived.
model Course {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  /// Optional, and unique in the organization when set
  code            String?
  description     String?
  /// Free text like "B2" or "Grade 5"
  level           String
  /// Exactly one; a department with courses, archived ones included, can't be removed
  department_id   String       @db.Uuid
  status          CourseStatus @default(ACTIVE)

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// NoAction: a department with courses can't be deleted (the department service says why), while deleting the organization still removes both, as both sit directly under it
  department      Department   @relation(fields: [department_id], references: [id], onDelete: NoAction)
  groups          Group[]

  @@unique([organization_id, name])
  @@unique([organization_id, code])
  @@index([organization_id, status])
  @@index([department_id])
}

/// A class the organization runs: one course in one school year. Groups are archived, never deleted.
model Group {
  id               String        @id @default(uuid()) @db.Uuid
  organization_id  String        @db.Uuid
  course_id        String        @db.Uuid
  name             String
  academic_year_id String        @db.Uuid
  /// Removing the term keeps the group, without one
  academic_term_id String?       @db.Uuid
  /// Stands in for a room until rooms exist; removing the location keeps the group, without one
  location_id      String?       @db.Uuid
  /// Seats; a full group takes no new students and can't drop below its active ones (kept by the groups services); null for no limit
  capacity         Int?
  status           GroupStatus   @default(ACTIVE)

  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  organization     Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  course           Course        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  /// NoAction: a year with groups can't be deleted (the academic periods service says why), while deleting the organization still removes both
  academic_year    AcademicYear  @relation(fields: [academic_year_id], references: [id], onDelete: NoAction)
  academic_term    AcademicTerm? @relation(fields: [academic_term_id], references: [id], onDelete: SetNull)
  location         Location?     @relation(fields: [location_id], references: [id], onDelete: SetNull)
  lecturer_assignments GroupLecturerAssignment[]
  substitutions    GroupSubstitution[]
  meetings         GroupMeeting[]
  enrolments       GroupEnrolment[]
  attendance       AttendanceRecord[]
  reschedules      LessonReschedule[]
  lesson_plans     LessonPlan[]

  @@unique([course_id, academic_year_id, name])
  @@index([organization_id, status])
  @@index([academic_year_id])
  @@index([academic_term_id])
  @@index([location_id])
}

/// One weekly meeting of a group, like Monday 17:00 to 18:30. It runs for the group's term, or its whole school year without one; on one day they don't overlap (kept by the groups service).
model GroupMeeting {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  weekday    Weekday
  /// Wall-clock times with no time zone, like the calendar days in @db.Date; end_time is after start_time
  start_time DateTime @db.Time(0)
  end_time   DateTime @db.Time(0)

  created_at DateTime @default(now())

  group      Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
}

/// A student in a group; the course follows from the group. Withdrawing sets withdrawn_on and keeps the row, and enrolling again adds a new one,
/// so the history stays. A student is active at most once per group, and a group holds at most its capacity of active rows (kept by the group enrolments service).
model GroupEnrolment {
  id           String    @id @default(uuid()) @db.Uuid
  group_id     String    @db.Uuid
  student_id   String    @db.Uuid
  /// Calendar days in the organization's time zone
  enrolled_on  DateTime  @db.Date
  /// Null while active
  withdrawn_on DateTime? @db.Date

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  group        Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  /// Cascade, not NoAction: a row sits under the organization through the group, so a NoAction check would run before that cascade reaches it and block deleting the organization. Students are archived, never deleted on their own.
  student      Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([group_id, withdrawn_on])
  @@index([student_id, withdrawn_on])
}

/// One student's mark in the register of one lesson session: a group on a day at a start time. A group meeting twice a day has two registers.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  group_id     String           @db.Uuid
  student_id   String           @db.Uuid
  /// The lesson's calendar day in the organization's time zone
  date         DateTime         @db.Date
  /// The session's wall-clock start, stored rather than read from the schedule, so a later schedule change keeps the register where it was.
  /// Rows from before sessions existed took their day's first meeting, or 00:00 on a day with none.
  start_time   DateTime         @db.Time(0)
  status       AttendanceStatus
  /// Who set the current status; null once that user is deleted, and the mark stays
  marked_by_id String?          @db.Uuid

  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  group        Group            @relation(fields: [group_id], references: [id], onDelete: Cascade)
  /// Cascade, not NoAction: a row sits under the organization through the group, so a NoAction check would run before that cascade reaches it and block deleting the organization. Students are archived, never deleted on their own.
  student      Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  marked_by    User?            @relation(fields: [marked_by_id], references: [id], onDelete: SetNull)

  @@unique([group_id, student_id, date, start_time])
  @@index([group_id, date, start_time])
  @@index([student_id])
  @@index([marked_by_id])
}

/// One regular session of a group moved to another date and time. The weekly schedule stays as it is; the original's end and everything else
/// about it come from the original date and that schedule, so nothing is copied. Cancelling sets cancelled_at, keeps the row and brings the original back.
/// A session has at most one active reschedule, and a moved session isn't moved again (kept by the lesson reschedules service).
model LessonReschedule {
  id                  String    @id @default(uuid()) @db.Uuid
  group_id            String    @db.Uuid
  /// The regular session moved away: its calendar day and wall-clock start
  original_date       DateTime  @db.Date
  original_start_time DateTime  @db.Time(0)
  /// Where it runs instead; its register sits on this day and start
  new_date            DateTime  @db.Date
  new_start_time      DateTime  @db.Time(0)
  new_end_time        DateTime  @db.Time(0)
  /// For staff only
  reason              String?
  /// Null once that user is deleted, and the reschedule stays
  created_by_id       String?   @db.Uuid
  created_at          DateTime  @default(now())
  /// Set when cancelled; the row stays on record
  cancelled_at        DateTime?

  /// Cascade: a row sits under the organization through the group, so deleting the organization removes it
  group               Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  created_by          User?     @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([group_id, original_date])
  @@index([group_id, new_date])
  @@index([created_by_id])
}

/// One lesson session's plan: a group on a day at a start time. The topic may be set ahead of the session; what was covered only from its start time on.
/// Both are free text and optional; a session with neither doesn't need a row.
model LessonPlan {
  id            String    @id @default(uuid()) @db.Uuid
  group_id      String    @db.Uuid
  /// The lesson's calendar day in the organization's time zone
  date          DateTime  @db.Date
  /// The session's wall-clock start, stored rather than read from the schedule, for the same reason as on AttendanceRecord
  start_time    DateTime  @db.Time(0)
  /// Planned ahead of the session; editable at any time
  topic         String?
  /// What was actually covered; editable only from the session's start time on
  covered       String?
  /// Who last wrote to this row; null once that user is deleted, and the row stays
  updated_by_id String?   @db.Uuid

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  /// Cascade, not NoAction: a row sits under the organization through the group, same reasoning as AttendanceRecord
  group         Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  updated_by    User?     @relation(fields: [updated_by_id], references: [id], onDelete: SetNull)

  @@unique([group_id, date, start_time])
  @@index([group_id, date, start_time])
  @@index([updated_by_id])
}

/// Who permanently teaches a group, and since when. A change closes the row and adds a new one, so the history stays; the current lecturer is the row covering the organization's today.
model GroupLecturerAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  group_id    String    @db.Uuid
  lecturer_id String    @db.Uuid
  /// Calendar days, both included
  start_date  DateTime  @db.Date
  /// Null while open
  end_date    DateTime? @db.Date

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  group       Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  /// Cascade, not NoAction: a row sits under the organization through the group, so a NoAction check would run before that cascade reaches it and block deleting the organization. Lecturers are archived, never deleted on their own.
  lecturer    Lecturer  @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([group_id, start_date])
  @@index([lecturer_id])
}

/// Someone covering a group for a day or a date range. It never touches the permanent rows, so when it ends the group simply carries on with its lecturer.
model GroupSubstitution {
  id           String    @id @default(uuid()) @db.Uuid
  group_id     String    @db.Uuid
  lecturer_id  String    @db.Uuid
  /// Calendar days, both included; one day when they are equal
  start_date   DateTime  @db.Date
  end_date     DateTime  @db.Date
  note         String?
  /// Set when cancelled; the row stays on record and frees its days
  cancelled_at DateTime?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  group        Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  /// Cascade for the same reason as on GroupLecturerAssignment
  lecturer     Lecturer  @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([group_id, start_date])
  @@index([lecturer_id, end_date])
}

/// A user's place in one organization. One user can belong to many organizations, once each.
model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  user_id         String           @db.Uuid
  organization_id String           @db.Uuid
  role            MemberRole
  permissions     Permission[]
  status          MembershipStatus @default(ACTIVE)

  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id])
  @@index([organization_id, role])
}

/// An invitation to join an organization by email. The link's token is stored only as its sha256 hash.
/// At most one PENDING invitation per (organization, email), per student and per lecturer, kept by the invitation service.
model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  email           String
  role            MemberRole
  permissions     Permission[]
  /// Set for a student invitation: accepting links the login to this existing record
  student_id      String?          @db.Uuid
  /// Set for a lecturer invitation, the same way
  lecturer_id     String?          @db.Uuid
  token_hash      String           @unique
  status          InvitationStatus @default(PENDING)
  expires_at      DateTime
  invited_by_id   String           @db.Uuid

  created_at      DateTime         @default(now())
  accepted_at     DateTime?
  revoked_at      DateTime?

  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invited_by      User             @relation("InvitedBy", fields: [invited_by_id], references: [id])
  /// Cascade: an invitation for a deleted record could never be accepted correctly
  student         Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  lecturer        Lecturer?        @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([email])
  @@index([student_id])
  @@index([lecturer_id])
}

// ─────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────

/// Who did what and when. Links become null when a user or organization is deleted, so the entry stays.
model ActivityLog {
  id              String         @id @default(uuid()) @db.Uuid
  /// Null for system events, like a lockout after failed logins
  actor_id        String?        @db.Uuid
  action          ActivityAction
  organization_id String?        @db.Uuid
  target_user_id  String?        @db.Uuid
  /// The location's, department's, academic period's, student's, lecturer's, course's or group's name, or the invited email, so the entry still reads right after it is removed.
  /// For a student joining, leaving or moving between groups, the student and the groups as they were named then, like "Arta Gashi from Group A to Group B".
  /// For an attendance correction, the student, group, lesson day and session start, like "Arta Gashi in Group A on 2026-11-07, 17:00".
  /// For a lesson moved or a move cancelled, the group and both sessions, like "Group A from 2026-11-16 09:00 to 2026-11-20 16:00".
  subject_name    String?
  created_at      DateTime       @default(now())

  actor           User?          @relation("ActivityActor", fields: [actor_id], references: [id], onDelete: SetNull)
  organization    Organization?  @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  target_user     User?          @relation("ActivityTarget", fields: [target_user_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([organization_id])
  @@index([action])
}
