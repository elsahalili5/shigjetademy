PORT=3001

# Postgres from docker-compose.yml (`npm run db:up` at the root)
DATABASE_URL="postgresql://shigjetademy:shigjetademy@localhost:5432/shigjetademy"

# Platform admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@shigjetademy.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Sign access (15m) and refresh (7d) tokens. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
